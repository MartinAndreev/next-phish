DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=business_trips
# Optional Prisma pool size (connections)
# DB_CONNECTION_LIMIT=10

APP_PORT=80
STATIC_SERVER_PORT=3001

BETTER_AUTH_SECRET=replace-with-a-32-plus-character-secret
BETTER_AUTH_URL=http://localhost
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost
APP_URL=http://localhost

# Docker app container resource limits
APP_CPU_LIMIT=2.0
APP_MEMORY_LIMIT=3g
APP_MEMORY_RESERVATION=1g

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@business-trips.local

# Redis connection (used for BullMQ queues and pub/sub events)
REDIS_HOST=localhost
REDIS_PORT=6379

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=business-trips-private

# Logging (used in production; dev always uses pino-pretty to stdout)
# LOG_DIR=./storage/logs
# LOG_LEVEL=info

# Encryption key for page form submissions (64-char hex = 256-bit)
# Generate with: openssl rand -hex 32
PAGE_SUBMISSION_ENCRYPTION_KEY=replace-with-a-64-character-hex-key
