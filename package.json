{
  "name": "next-phish",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,md,yml,yaml,css,scss}\"",
    "db:generate": "pnpm --filter @next-phish/database exec prisma generate",
    "db:migrate": "pnpm --filter @next-phish/database exec prisma migrate dev",
    "db:migrate:create": "pnpm --filter @next-phish/database exec prisma migrate dev --create-only",
    "db:migrate:deploy": "pnpm --filter @next-phish/database exec prisma migrate deploy",
    "db:push": "pnpm --filter @next-phish/database exec prisma db push",
    "db:studio": "pnpm --filter @next-phish/database exec prisma studio",
    "db:seed": "pnpm --filter @next-phish/database exec prisma db seed",
    "setup": "bash scripts/symlink-env.sh",
    "prepare": "husky"
  },
  "packageManager": "pnpm@10.33.4",
  "devDependencies": {
    "@commitlint/cli": "^21",
    "@commitlint/config-conventional": "^21",
    "@eslint/js": "^9",
    "@hkdobrev/run-if-changed": "^0.6",
    "eslint": "^9",
    "globals": "^17.6.0",
    "husky": "^9",
    "lint-staged": "^17",
    "prettier": "^3",
    "turbo": "^2",
    "typescript": "^6",
    "typescript-eslint": "^8"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,mdx,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  },
  "run-if-changed": {
    "package.json": "pnpm install --prefer-frozen-lockfile"
  }
}
