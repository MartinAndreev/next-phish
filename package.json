{
  "name": "next-phish",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:static-server": "tsx watch src/static-server/index.ts",
    "dev:worker": "tsx watch src/server/worker.ts",
    "build": "next build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "next start",
    "start:static-server": "node dist/static-server/index.js",
    "start:worker": "node dist/server/worker.js",
    "lint": "eslint"
  },
  "dependencies": {
    "@hono/node-server": "^1",
    "hono": "^4",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@hkdobrev/run-if-changed": "^0.6.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "husky": "^9.1.7",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,mdx,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  },
  "run-if-changed": {
    "package.json": "pnpm install --prefer-frozen-lockfile"
  }
}
