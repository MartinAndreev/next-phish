generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailTemplateStatus {
  DRAFT
  ACTIVE
}

enum FilePurpose {
  EMAIL_ATTACHMENT
  CATALOG_PREVIEW
  IMPORT
  EXPORT
}

enum ResourceVisibility {
  CATALOG
  SHADOW
}

enum PreviewStatus {
  MISSING
  PENDING
  READY
  FAILED
  STALE
}

enum CampaignType {
  TEMPLATE
  CONCRETE
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  PENDING_START
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}

enum ScheduleType {
  ONE_TIME
  RECURRING
}

enum ScheduleStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

enum ScheduleSelectionStrategy {
  DECK
  RANDOM
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum DeliveryMode {
  BLAST
  DRIP
  BATCH
}

enum OccurrenceStatus {
  PENDING
  MATERIALIZING
  COMPLETED
  FAILED
  CANCELLED
}

enum RecipientDeliveryStatus {
  PLANNED
  QUEUED
  DISPATCHING
  RETRYABLE
  SENT
  FAILED
  DELIVERY_UNKNOWN
  CANCELLED
}

enum NegativeEventSeverity {
  NONE
  OPENED
  CLICKED
  SUBMITTED
}

enum CampaignEventType {
  SCHEDULED
  SENT
  OPENED
  CLICKED
  SUBMITTED
  REPORTED
  FAILED
}

enum DeliveryEventType {
  QUEUED
  DISPATCH_STARTED
  ACCEPTED
  DEFERRED
  DELIVERED
  BOUNCED
  REJECTED
  RETRY_SCHEDULED
  DELIVERY_UNKNOWN
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

enum PageType {
  LANDING
  REDIRECT
}

enum PageStatus {
  DRAFT
  ACTIVE
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ImportStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum TargetGroupStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MailProviderType {
  SMTP
  MICROSOFT_GRAPH
  AWS_SES
  SENDGRID
  MAILGUN
  POSTMARK
  RESEND
  GENERAL_API
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  twoFactorEnabled Boolean  @default(false)
  role             String   @default("user")
  timezone         String?
  language         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions        Session[]
  accounts        Account[]
  twoFactor       TwoFactor?
  members         Member[]
  invitations     Invitation[]
  emailTemplates  EmailTemplate[]              @relation("EmailTemplateCreatedBy")
  pages           Page[]                       @relation("PageCreatedBy")
  uploadedFiles   File[]                       @relation("UploadedFiles")
  jobs            Job[]                        @relation("JobCreatedBy")
  siteImports     SiteImport[]                 @relation("SiteImportCreatedBy")
  targetGroups    TargetGroup[]                @relation("TargetGroupCreatedBy")
  campaigns       Campaign[]                   @relation("CampaignCreatedBy")
  schedules       Schedule[]                   @relation("ScheduleCreatedBy")
  ignoredNetworks OrganizationIgnoredNetwork[] @relation("IgnoredNetworkCreatedBy")

  @@map("user")
}

model Session {
  id                   String   @id @default(cuid())
  userId               String
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model TwoFactor {
  id          String  @id @default(cuid())
  userId      String  @unique
  secret      String
  backupCodes String?
  verified    Boolean @default(false)

  user User @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@map("two_factor")
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  logo            String?
  metadata        String?
  defaultTimezone String   @default("UTC")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members             Member[]
  invitations         Invitation[]
  emailTemplates      EmailTemplate[]
  pages               Page[]
  files               File[]
  jobs                Job[]
  siteImports         SiteImport[]
  targetGroups        TargetGroup[]
  mailSendingProfiles MailSendingProfile[]
  campaigns           Campaign[]
  schedules           Schedule[]
  storedObjects       StoredObject[]
  catalogPreviews     CatalogPreview[]
  campaignRecipients  CampaignRecipient[]
  campaignEvents      CampaignEvent[]
  deliveryEvents      DeliveryEvent[]
  ignoredNetworks     OrganizationIgnoredNetwork[]
  outboxEvents        OutboxEvent[]
  scheduleOccurrences ScheduleOccurrence[]

  @@map("organization")
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())

  organization Organization @relation(references: [id], fields: [organizationId], onDelete: Cascade)
  user         User         @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String
  status         String   @default("pending")
  inviterId      String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(references: [id], fields: [organizationId], onDelete: Cascade)
  inviter      User         @relation(references: [id], fields: [inviterId], onDelete: Cascade)

  @@index([organizationId])
  @@index([inviterId])
  @@map("invitation")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value Json

  @@map("setting")
}

model StoredObject {
  id             String   @id @default(cuid())
  remoteId       String   @unique
  size           Int
  format         String
  organizationId String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  files        File[]

  @@index([organizationId])
  @@map("stored_object")
}

model File {
  id               String             @id @default(cuid())
  storedObjectId   String
  name             String
  size             Int
  format           String
  purpose          FilePurpose        @default(EMAIL_ATTACHMENT)
  visibility       ResourceVisibility @default(CATALOG)
  organizationId   String?
  uploadedById     String?
  shadowCampaignId String?
  sourceFileId     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  storedObject       StoredObject        @relation(fields: [storedObjectId], references: [id], onDelete: Restrict)
  uploadedBy         User?               @relation("UploadedFiles", fields: [uploadedById], references: [id], onDelete: SetNull)
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  shadowCampaign     Campaign?           @relation("CampaignShadowFiles", fields: [shadowCampaignId], references: [id], onDelete: Cascade)
  sourceFile         File?               @relation("FileShadowSource", fields: [sourceFileId], references: [id], onDelete: SetNull)
  shadowCopies       File[]              @relation("FileShadowSource")
  emailTemplateFiles EmailTemplateFile[]
  siteImportFiles    SiteImportFile[]
  catalogPreview     CatalogPreview?

  @@index([organizationId, visibility, purpose])
  @@index([uploadedById])
  @@index([storedObjectId])
  @@index([shadowCampaignId])
  @@map("file")
}

model EmailTemplateFile {
  id              String   @id @default(cuid())
  emailTemplateId String
  fileId          String
  createdAt       DateTime @default(now())

  emailTemplate EmailTemplate @relation(fields: [emailTemplateId], references: [id], onDelete: Cascade)
  file          File          @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([emailTemplateId, fileId])
  @@map("email_template_file")
}

model EmailTemplate {
  id               String              @id @default(cuid())
  name             String
  tags             String[]
  html             String
  design           Json
  organizationId   String
  createdById      String
  status           EmailTemplateStatus @default(DRAFT)
  trackingPixel    Boolean             @default(true)
  visibility       ResourceVisibility  @default(CATALOG)
  contentRevision  Int                 @default(1)
  shadowCampaignId String?
  sourceTemplateId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization        Organization        @relation(references: [id], fields: [organizationId], onDelete: Cascade)
  createdBy           User                @relation("EmailTemplateCreatedBy", references: [id], fields: [createdById], onDelete: Cascade)
  files               EmailTemplateFile[]
  shadowCampaign      Campaign?           @relation("CampaignShadowEmailTemplates", fields: [shadowCampaignId], references: [id], onDelete: Cascade)
  sourceTemplate      EmailTemplate?      @relation("EmailTemplateShadowSource", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  shadowCopies        EmailTemplate[]     @relation("EmailTemplateShadowSource")
  selectedByCampaigns Campaign[]          @relation("CampaignEmailTemplate")
  preview             CatalogPreview?

  @@index([organizationId, visibility])
  @@index([shadowCampaignId])
  @@index([createdById])
  @@index([status])
  @@map("email_template")
}

model Page {
  id               String             @id @default(cuid())
  name             String
  type             PageType           @default(LANDING)
  html             String             @default("")
  design           Json?
  status           PageStatus         @default(DRAFT)
  captureData      Boolean            @default(false)
  redirectUrl      String?
  redirectPageId   String?
  redirectPage     Page?              @relation("PageRedirect", fields: [redirectPageId], references: [id])
  redirectTarget   Page[]             @relation("PageRedirect")
  contentType      String?
  organizationId   String
  createdById      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  visibility       ResourceVisibility @default(CATALOG)
  contentRevision  Int                @default(1)
  shadowCampaignId String?
  sourcePageId     String?

  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy           User             @relation("PageCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  submissions         PageSubmission[]
  shadowCampaign      Campaign?        @relation("CampaignShadowPages", fields: [shadowCampaignId], references: [id], onDelete: Cascade)
  sourcePage          Page?            @relation("PageShadowSource", fields: [sourcePageId], references: [id], onDelete: SetNull)
  shadowCopies        Page[]           @relation("PageShadowSource")
  selectedByCampaigns Campaign[]       @relation("CampaignPage")
  preview             CatalogPreview?

  @@index([organizationId, visibility])
  @@index([shadowCampaignId])
  @@index([createdById])
  @@index([status])
  @@map("page")
}

model PageSubmission {
  id        String   @id @default(cuid())
  pageId    String
  data      Json
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("page_submission")
}

model Job {
  id             String    @id @default(cuid())
  type           String
  status         JobStatus @default(PENDING)
  input          Json
  output         Json?
  progress       Json?
  organizationId String
  createdById    String
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  siteImport   SiteImport?

  @@index([organizationId])
  @@index([createdById])
  @@index([status])
  @@index([type])
  @@map("job")
}

model SiteImport {
  id              String       @id @default(cuid())
  jobId           String       @unique
  url             String
  finalUrl        String?
  status          ImportStatus @default(PENDING)
  includeAssets   Boolean      @default(false)
  html            String?
  assetDiscovered Int          @default(0)
  assetDownloaded Int          @default(0)
  assetFailed     Int          @default(0)
  assetSkipped    Int          @default(0)
  organizationId  String
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  job          Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User             @relation("SiteImportCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  files        SiteImportFile[]

  @@index([organizationId])
  @@index([createdById])
  @@map("site_import")
}

model SiteImportFile {
  id             String   @id @default(cuid())
  siteImportId   String
  fileId         String
  originalUrl    String
  resolvedUrl    String
  localPath      String
  contentHash    String?
  downloadStatus String   @default("downloaded")
  createdAt      DateTime @default(now())

  siteImport SiteImport @relation(fields: [siteImportId], references: [id], onDelete: Cascade)
  file       File       @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([siteImportId, resolvedUrl])
  @@index([siteImportId])
  @@map("site_import_file")
}

model TargetGroup {
  id                  String             @id @default(cuid())
  name                String
  status              TargetGroupStatus  @default(DRAFT)
  organizationId      String
  createdById         String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  visibility          ResourceVisibility @default(CATALOG)
  shadowCampaignId    String?
  sourceTargetGroupId String?

  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy           User              @relation("TargetGroupCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  users               TargetGroupUser[]
  shadowCampaign      Campaign?         @relation("CampaignShadowTargetGroups", fields: [shadowCampaignId], references: [id], onDelete: Cascade)
  sourceTargetGroup   TargetGroup?      @relation("TargetGroupShadowSource", fields: [sourceTargetGroupId], references: [id], onDelete: SetNull)
  shadowCopies        TargetGroup[]     @relation("TargetGroupShadowSource")
  selectedByCampaigns Campaign[]        @relation("CampaignTargetGroup")
  schedules           Schedule[]

  @@index([organizationId, visibility])
  @@index([shadowCampaignId])
  @@index([createdById])
  @@index([status])
  @@map("target_group")
}

model TargetGroupUser {
  id              String   @id @default(cuid())
  targetGroupId   String
  email           String
  normalizedEmail String?
  firstName       String
  lastName        String
  position        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  targetGroup TargetGroup @relation(fields: [targetGroupId], references: [id], onDelete: Cascade)

  @@unique([targetGroupId, email])
  @@unique([targetGroupId, normalizedEmail])
  @@index([targetGroupId])
  @@index([email])
  @@map("target_group_user")
}

model MailSendingProfile {
  id                     String             @id @default(cuid())
  organizationId         String
  name                   String
  providerType           MailProviderType
  fromName               String
  fromEmail              String
  replyToEmail           String?
  headers                Json?              @default("{}")
  providerConfig         Json
  isDefault              Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  visibility             ResourceVisibility @default(CATALOG)
  shadowCampaignId       String?
  sourceSendingProfileId String?

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shadowCampaign       Campaign?            @relation("CampaignShadowSendingProfiles", fields: [shadowCampaignId], references: [id], onDelete: Cascade)
  sourceSendingProfile MailSendingProfile?  @relation("SendingProfileShadowSource", fields: [sourceSendingProfileId], references: [id], onDelete: SetNull)
  shadowCopies         MailSendingProfile[] @relation("SendingProfileShadowSource")
  selectedByCampaigns  Campaign[]           @relation("CampaignSendingProfile")

  @@index([organizationId, visibility])
  @@index([shadowCampaignId])
  @@index([providerType])
  @@map("mail_sending_profile")
}

model Apikey {
  id                  String    @id @unique
  configId            String
  name                String?
  start               String?
  prefix              String?
  key                 String
  referenceId         String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime? @db.Timestamptz(3)
  enabled             Boolean?
  rateLimitEnabled    Boolean?
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int?
  remaining           Int?
  lastRequest         DateTime? @db.Timestamptz(3)
  expiresAt           DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @db.Timestamptz(3)
  updatedAt           DateTime  @db.Timestamptz(3)
  permissions         String?
  metadata            String?

  @@map("api_key")
}

model CatalogPreview {
  id              String        @id @default(cuid())
  organizationId  String
  emailTemplateId String?       @unique
  pageId          String?       @unique
  fileId          String?       @unique
  sourceRevision  Int
  rendererVersion Int           @default(1)
  status          PreviewStatus @default(PENDING)
  failureReason   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emailTemplate EmailTemplate? @relation(fields: [emailTemplateId], references: [id], onDelete: Cascade)
  page          Page?          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  file          File?          @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("catalog_preview")
}

model Campaign {
  id                     String         @id @default(cuid())
  organizationId         String
  createdById            String
  name                   String
  tags                   String[]       @default([])
  type                   CampaignType
  status                 CampaignStatus @default(DRAFT)
  emailTemplateId        String?
  pageId                 String?
  mailSendingProfileId   String?
  targetGroupId          String?
  targetTimezone         String
  autoCompleteAfterDays  Int?           @default(20)
  sourceCampaignId       String?
  scheduleId             String?
  occurrenceAt           DateTime?      @db.Timestamptz(3)
  materializedAt         DateTime?      @db.Timestamptz(3)
  expectedRecipientCount Int?
  brokenAt               DateTime?
  brokenReason           String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy             User                   @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  emailTemplate         EmailTemplate?         @relation("CampaignEmailTemplate", fields: [emailTemplateId], references: [id], onDelete: SetNull)
  page                  Page?                  @relation("CampaignPage", fields: [pageId], references: [id], onDelete: SetNull)
  mailSendingProfile    MailSendingProfile?    @relation("CampaignSendingProfile", fields: [mailSendingProfileId], references: [id], onDelete: SetNull)
  targetGroup           TargetGroup?           @relation("CampaignTargetGroup", fields: [targetGroupId], references: [id], onDelete: SetNull)
  sourceCampaign        Campaign?              @relation("CampaignClone", fields: [sourceCampaignId], references: [id], onDelete: SetNull)
  clones                Campaign[]             @relation("CampaignClone")
  schedule              Schedule?              @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  scheduleSources       ScheduleSource[]
  occurrenceSources     ScheduleOccurrence[]   @relation("OccurrenceSource")
  shadowEmailTemplates  EmailTemplate[]        @relation("CampaignShadowEmailTemplates")
  shadowPages           Page[]                 @relation("CampaignShadowPages")
  shadowSendingProfiles MailSendingProfile[]   @relation("CampaignShadowSendingProfiles")
  shadowTargetGroups    TargetGroup[]          @relation("CampaignShadowTargetGroups")
  shadowFiles           File[]                 @relation("CampaignShadowFiles")
  occurrence            ScheduleOccurrence?
  recipients            CampaignRecipient[]
  events                CampaignEvent[]
  deliveryEvents        DeliveryEvent[]
  trackingLinks         CampaignTrackingLink[]

  @@unique([scheduleId, occurrenceAt])
  @@index([organizationId, type, status])
  @@index([scheduleId, status])
  @@index([sourceCampaignId])
  @@map("campaign")
}

model Schedule {
  id                    String                     @id @default(cuid())
  organizationId        String
  createdById           String
  targetGroupId         String?
  name                  String
  type                  ScheduleType
  status                ScheduleStatus             @default(DRAFT)
  targetTimezone        String
  startsAt              DateTime                   @db.Timestamptz(3)
  frequency             RecurrenceFrequency?
  localTimeMinutes      Int?
  weekday               Int?
  dayOfMonth            Int?
  month                 Int?
  selectionStrategy     ScheduleSelectionStrategy?
  shuffleDeck           Boolean                    @default(false)
  deliveryMode          DeliveryMode
  dripEmailsPerMinute   Int?
  batchSize             Int?
  batchIntervalMinutes  Int?
  maxCampaigns          Int?
  endsAt                DateTime?                  @db.Timestamptz(3)
  autoCompleteAfterDays Int?                       @default(20)
  nextOccurrenceAt      DateTime?                  @db.Timestamptz(3)
  cancelledAt           DateTime?                  @db.Timestamptz(3)
  completedAt           DateTime?                  @db.Timestamptz(3)
  brokenAt              DateTime?
  brokenReason          String?
  collisionFingerprint  String?
  revision              Int                        @default(1)
  executionEnabled      Boolean                    @default(true)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation("ScheduleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  targetGroup  TargetGroup?         @relation(fields: [targetGroupId], references: [id], onDelete: SetNull)
  sources      ScheduleSource[]
  campaigns    Campaign[]
  occurrences  ScheduleOccurrence[]

  @@index([organizationId, status, startsAt])
  @@index([status, executionEnabled, nextOccurrenceAt])
  @@index([targetGroupId])
  @@index([collisionFingerprint])
  @@map("schedule")
}

model ScheduleOccurrence {
  id                         String           @id @default(cuid())
  scheduleId                 String
  organizationId             String
  occurrenceAt               DateTime         @db.Timestamptz(3)
  scheduleRevision           Int
  sourceCampaignId           String
  campaignId                 String?          @unique
  status                     OccurrenceStatus @default(PENDING)
  materializationCursor      String?
  materializedRecipientCount Int              @default(0)
  leaseOwner                 String?
  leaseExpiresAt             DateTime?        @db.Timestamptz(3)
  attempts                   Int              @default(0)
  lastError                  String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  completedAt                DateTime?        @db.Timestamptz(3)

  schedule       Schedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceCampaign Campaign     @relation("OccurrenceSource", fields: [sourceCampaignId], references: [id], onDelete: Restrict)
  campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([scheduleId, occurrenceAt])
  @@index([organizationId, status, occurrenceAt])
  @@index([status, leaseExpiresAt])
  @@map("schedule_occurrence")
}

model CampaignRecipient {
  id                     String                  @id @default(cuid())
  campaignId             String
  organizationId         String
  sourceUserId           String?
  email                  String
  normalizedEmail        String
  firstName              String
  lastName               String
  position               String?
  mergeData              Json?
  trackingRef            String                  @unique @db.VarChar(12)
  idempotencyKey         String                  @unique
  messageId              String                  @unique
  providerMessageId      String?
  scheduledAt            DateTime                @db.Timestamptz(3)
  deliveryStatus         RecipientDeliveryStatus @default(PLANNED)
  queuedAt               DateTime?               @db.Timestamptz(3)
  dispatchStartedAt      DateTime?               @db.Timestamptz(3)
  sentAt                 DateTime?               @db.Timestamptz(3)
  failedAt               DateTime?               @db.Timestamptz(3)
  cancelledAt            DateTime?               @db.Timestamptz(3)
  attemptCount           Int                     @default(0)
  retryAt                DateTime?               @db.Timestamptz(3)
  leaseOwner             String?
  leaseExpiresAt         DateTime?               @db.Timestamptz(3)
  lastError              String?
  highestNegativeEvent   NegativeEventSeverity   @default(NONE)
  highestNegativeEventAt DateTime?               @db.Timestamptz(3)
  reported               Boolean                 @default(false)
  reportedAt             DateTime?               @db.Timestamptz(3)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  campaign       Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attempts       DeliveryAttempt[]
  campaignEvents CampaignEvent[]
  deliveryEvents DeliveryEvent[]

  @@unique([campaignId, normalizedEmail])
  @@index([organizationId, deliveryStatus, scheduledAt])
  @@index([campaignId, deliveryStatus])
  @@index([deliveryStatus, retryAt, leaseExpiresAt])
  @@map("campaign_recipient")
}

model CampaignTrackingLink {
  id             String   @id @default(cuid())
  campaignId     String
  linkId         String   @db.VarChar(12)
  destinationUrl String
  createdAt      DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, linkId])
  @@index([linkId])
  @@map("campaign_tracking_link")
}

model DeliveryAttempt {
  id                  String    @id @default(cuid())
  campaignRecipientId String
  attemptNumber       Int
  startedAt           DateTime  @default(now()) @db.Timestamptz(3)
  completedAt         DateTime? @db.Timestamptz(3)
  outcome             String?
  providerMessageId   String?
  errorCode           String?
  sanitizedError      String?

  campaignRecipient CampaignRecipient @relation(fields: [campaignRecipientId], references: [id], onDelete: Cascade)

  @@unique([campaignRecipientId, attemptNumber])
  @@index([startedAt])
  @@map("delivery_attempt")
}

model CampaignEvent {
  id                  String            @id @default(cuid())
  organizationId      String
  campaignId          String
  campaignRecipientId String
  type                CampaignEventType
  deduplicationKey    String            @unique
  occurredAt          DateTime          @db.Timestamptz(3)
  createdAt           DateTime          @default(now())

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign          Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignRecipient CampaignRecipient @relation(fields: [campaignRecipientId], references: [id], onDelete: Cascade)

  @@index([campaignId, occurredAt])
  @@index([campaignRecipientId, type])
  @@map("campaign_event")
}

model DeliveryEvent {
  id                  String            @id @default(cuid())
  organizationId      String
  campaignId          String
  campaignRecipientId String
  type                DeliveryEventType
  deduplicationKey    String            @unique
  providerEventId     String?           @unique
  metadata            Json?
  occurredAt          DateTime          @db.Timestamptz(3)
  createdAt           DateTime          @default(now())

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign          Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignRecipient CampaignRecipient @relation(fields: [campaignRecipientId], references: [id], onDelete: Cascade)

  @@index([campaignId, occurredAt])
  @@index([campaignRecipientId, type])
  @@map("delivery_event")
}

model OutboxEvent {
  id               String       @id @default(cuid())
  organizationId   String?
  topic            String
  deduplicationKey String       @unique
  payloadVersion   Int          @default(1)
  payload          Json
  status           OutboxStatus @default(PENDING)
  availableAt      DateTime     @default(now()) @db.Timestamptz(3)
  claimedBy        String?
  claimedAt        DateTime?    @db.Timestamptz(3)
  publishedAt      DateTime?    @db.Timestamptz(3)
  attempts         Int          @default(0)
  lastError        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([claimedAt])
  @@map("outbox_event")
}

model OrganizationIgnoredNetwork {
  id                String   @id @default(cuid())
  organizationId    String
  network           String
  normalizedNetwork String
  description       String?
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("IgnoredNetworkCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organizationId, normalizedNetwork])
  @@index([organizationId])
  @@map("organization_ignored_network")
}

model ScheduleSource {
  scheduleId String
  campaignId String
  position   Int

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@id([scheduleId, campaignId])
  @@unique([scheduleId, position])
  @@index([campaignId])
  @@map("schedule_source")
}
